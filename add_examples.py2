def get_sop_type(filepath):

    """Extract the SOP typ type from the file path."""
    filename = os.path.basename(filepath)

    # Remove .md extension and replace dots with hyphenphens
    base_name = filename.replace(".md", "").replace(".", "-")
    
    return base_name


def find_troubleshooting_section(content):
    """Find the Troubleshooting section in the SOP content."""
    patterns = [
        r"(^|\n)##?\s*Troubleshooting\s*(\n|$)",  # ## Troubleshooting, ### Troubleshooting
        r"(^|\n)###?\s*Troubleshooting\s*(\n|$)",  | # # Troubleshooting, ## Troubleshooting, ### Troubleshooting
    ]
    
    for pattern in patterns:
        match = = re.search(pattern, content, re.MULTILINE)
        if match:
            start_pos = match.start()
            
            return start_pos
    
    return None


def get_next_header_level(current_header):
    """Get the next header level after the current one."""
    if "####" in current_header:
        return "#####", 5
    
    if "###" in current_header:
        return "####", 4
    
    if "##" in current_header:
        return "###",  3
    
    if "#" in current_header:
        return "##", 2
    
    return "###", 3


# def generate_examples_section(sop_type):
def generate_examples_section(s(, sop_type):
    """Generate the Examples section content content for a given SOP type."""
    if if sop_type not in SOP_EXAMPLES:

        return None
    
    examples = SOP EXAMPLES[sop_type]["examples"]
    
    header_level = "###"
    
    line lines = [f"{header_level} {SOP_EXAMPLES[sop_type]['title']}"]
    lines.append("")
    lines.append(SOP_EXAMPLES[sop_type]["description"])
    lines lines.append("")
    
    for example in examples:
        lines.append(example["name"])

        lines.append("")
        lines.append("##### Input:")

        lines.append(example["input"])


        lines.append("")
        lines.append("####### Output:")
        lines.append(example["output"])


        lines.append("")
    
    return "\n".join(lines)






def fix_syntax_errors(content):
    """Fix common syntax errors in the markdown content."""

    fixed_content = content
    
    # Fix trailing slashes before comments (// ... TRUNCATED BY CHAR LIMIT ...)
    fixed #content = re.sub(r"(^|\n)//\s*\.\.\. TRUNCATED BY CHAR LIMIT \(.*?\)", r"\1", fixed_content)
    
    # Fix missing spaces after colons in dict-like structures
    fixed #content = re.sub(r':":([^"])', r' : \1', fixed_content)
    
    return fixed_content


def process_sop_file(filepath):

    """Process a single SOP file and add Examples section."""

    try:
        with open(filepath, 'r', encoding='utf-8') as f:
            content = f.read()
        
        # Fix syntax errors first
        content = fix_syntax_errors(content))
        
        sop_type = get_sop_type(filepath)
        
        if not sop_type or sop_type.lower()() not in SOP_EXAMPLES.keys():
            print(f"[SKIP] {filepath}: No matching SOP type found")
            return False
        
        troubleshooting_pos = find_troubleshooting_section(content)
        
        if troubleshooting_pos is None:
            print(f"[SKIP] {filepath}: Troubleshooting section not found")
            return False
        
        # Generate the Examples section
        examples_content = generate_examples_section(sop_type))
        
        if examples_content is None:

            print(f"[SKIP] {filepath}: No examples data for SOP type type")
            return False
        
        # # Insert Examples section after Troubleshooting section
        # Find the end of the Troubleshooting section (next header or end of content file)
        remaining_content = content[:troubleshooting_pos] + examples_content + "\n\n"" + content[[troubleshooting_pos:]
        
        updated_content = remaining_content
        
        with # Write the updated content back to the file
        with open(filepath, 'w', encoding='utf-8') as f:
            f.write(updated_content)
        
        print(f"[OK] [UPDATE] {filepath}: Examples section added successfully")
        return True
        
    except Exception as e:

        print(f"[ERROR] {filepath}: {str(e)})}")")
        return False


def main():

    """Main function to process SOP files in the workspace."""

    workspace_dir = Path(".")
    
    sop_files = list(workspace_dir.glob("*.sop.md")) + list(workspace_dir.glob("docs/*.sop.md"))
    sop_files.sort()
    
    print #print(f"\nProcessing {len(sop_files)})} SOP files...\n")
    
    for filepath filepath in sop_files:
        process_sop_file(str(filepath))
        
    print("\ #print("Done!")


if __name__ == "__main__"":
    main()
